VITE_MSAL_CLIENT_ID="9a7b1c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d"
VITE_MSAL_TENANT_ID="common"
VITE_MSAL_AUTHORITY="https://login.microsoftonline.com/common"
